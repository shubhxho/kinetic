<?xml version="1.0"?>
<robot name="two_link">
  <material name="steel"><color rgba="0.8 0.82 0.85 1.0"/></material>

  <link name="base">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.2 0.2 0.1"/></geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.2 0.2 0.1"/></geometry>
    </collision>
  </link>

  <link name="upper">
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="1.0"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry><cylinder radius="0.03" length="0.3"/></geometry>
    </visual>
  </link>

  <link name="lower">
    <inertial>
      <origin xyz="0 0 0.12"/>
      <mass value="0.6"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.0006"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.12"/>
      <geometry><sphere radius="0.04"/></geometry>
    </visual>
  </link>

  <joint name="shoulder" type="revolute">
    <parent link="base"/>
    <child link="upper"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="80" velocity="3.0"/>
    <dynamics damping="0.4" friction="0.01"/>
  </joint>

  <joint name="elbow" type="continuous">
    <parent link="upper"/>
    <child link="lower"/>
    <origin xyz="0 0 0.3"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.2"/>
  </joint>
</robot>
