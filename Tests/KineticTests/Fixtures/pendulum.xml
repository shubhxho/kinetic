<mujoco model="mjcf_pendulum">
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <default>
    <geom rgba="0.7 0.72 0.78 1" density="1000"/>
    <joint damping="0.05" armature="0.01"/>
  </default>
  <worldbody>
    <geom name="floor" type="plane" size="10 10 0.1"/>
    <body name="cart" pos="0 0 0.6">
      <joint name="slide" type="slide" axis="1 0 0" range="-2 2"/>
      <geom name="cart_geom" type="box" size="0.12 0.07 0.05"/>
      <body name="pole" pos="0 0 0">
        <joint name="hinge" type="hinge" axis="0 1 0"/>
        <geom name="pole_geom" type="capsule" fromto="0 0 0 0 0 0.6" size="0.02"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor joint="slide" gear="40" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
